<!DOCTYPE html>
{#
  MFAudit — dark-corporate-report.html.j2  (invoked as --template terminal)
  Dark corporate theme: deep navy background, white body text, electric-blue
  accents, gold compliance score. All styles inline — no dependency on
  assets/report.css.
#}
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>RACF Security Audit – {{ system_name }}</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg:       #0d1117;
      --bg2:      #161b22;
      --bg3:      #1c2330;
      --border:   #30363d;
      --text:     #e6edf3;
      --text-dim: #8b949e;
      --accent:   #388bfd;
      --accent-d: #1f4f8f;
      --pass:     #3fb950;
      --fail:     #f85149;
      --review:   #d29922;
      --skip:     #484f58;
      --error:    #db6d28;
      --gold:     #e3b341;
    }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif;
      font-size: 10pt;
      line-height: 1.6;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .page { padding: 18mm 16mm; }
    .page-break { page-break-after: always; }

    /* ── COVER ────────────────────────────────────────────────────────── */
    .cover {
      padding: 30mm 20mm 24mm;
    }
    .cover-eyebrow {
      font-size: 8pt;
      text-transform: uppercase;
      letter-spacing: 4px;
      color: var(--accent);
      margin-bottom: 12px;
    }
    .cover-title {
      font-size: 28pt;
      font-weight: 700;
      color: var(--text);
      letter-spacing: -0.5px;
      line-height: 1.15;
      margin-bottom: 6px;
    }
    .cover-subtitle {
      font-size: 10pt;
      color: var(--text-dim);
      margin-bottom: 32px;
    }
    .cover-rule {
      border: none;
      border-top: 1px solid var(--border);
      margin: 24px 0;
    }
    .cover-meta {
      border-collapse: collapse;
      margin-bottom: 32px;
    }
    .cover-meta th {
      padding: 5px 20px 5px 0;
      color: var(--text-dim);
      font-weight: 400;
      font-size: 8.5pt;
      text-align: left;
      white-space: nowrap;
      vertical-align: top;
    }
    .cover-meta td {
      padding: 5px 0;
      color: var(--text);
      font-size: 9pt;
    }

    /* score pill */
    .score-wrap { display: flex; align-items: center; gap: 20px; margin: 8px 0 24px; }
    .score-pill {
      font-size: 26pt;
      font-weight: 700;
      padding: 6px 22px;
      border-radius: 6px;
      letter-spacing: 1px;
    }
    .score-pill.good { background: rgba(63,185,80,.15);  color: var(--pass); border: 1px solid var(--pass); }
    .score-pill.warn { background: rgba(210,153,34,.15); color: var(--gold); border: 1px solid var(--gold); }
    .score-pill.bad  { background: rgba(248,81,73,.15);  color: var(--fail); border: 1px solid var(--fail); }
    .score-legend {
      font-size: 8.5pt;
      color: var(--text-dim);
      line-height: 1.8;
    }
    .score-legend strong { color: var(--text); }

    .anon-banner {
      border: 1px solid var(--review);
      background: rgba(210,153,34,.08);
      color: var(--gold);
      padding: 10px 14px;
      border-radius: 4px;
      margin: 16px 0;
      font-size: 8.5pt;
    }

    .cover-disclaimer {
      font-size: 8pt;
      color: var(--text-dim);
      border-top: 1px solid var(--border);
      padding-top: 14px;
      margin-top: 24px;
      line-height: 1.6;
    }

    /* ── HEADINGS ─────────────────────────────────────────────────────── */
    h2 {
      font-size: 11pt;
      font-weight: 600;
      color: var(--text);
      border-bottom: 1px solid var(--border);
      padding-bottom: 6px;
      margin: 24px 0 16px;
    }
    h2::before { content: '// '; color: var(--accent); font-weight: 400; }
    h3 {
      font-size: 9pt;
      font-weight: 600;
      color: var(--text-dim);
      text-transform: uppercase;
      letter-spacing: 1.5px;
      margin: 18px 0 8px;
    }

    /* ── SUMMARY CARDS ────────────────────────────────────────────────── */
    .summary-row {
      display: flex;
      gap: 10px;
      margin-bottom: 22px;
    }
    .scard {
      flex: 1;
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 12px 8px;
      text-align: center;
    }
    .scard .n { font-size: 22pt; font-weight: 700; line-height: 1; }
    .scard .l { font-size: 7.5pt; color: var(--text-dim); margin-top: 5px; letter-spacing: 1px; }
    .scard.pass   { border-top: 3px solid var(--pass);   } .scard.pass   .n { color: var(--pass);   }
    .scard.fail   { border-top: 3px solid var(--fail);   } .scard.fail   .n { color: var(--fail);   }
    .scard.review { border-top: 3px solid var(--review); } .scard.review .n { color: var(--gold);   }
    .scard.skip   { border-top: 3px solid var(--skip);   } .scard.skip   .n { color: var(--skip);   }
    .scard.error  { border-top: 3px solid var(--error);  } .scard.error  .n { color: var(--error);  }

    /* ── OVERVIEW TABLE ───────────────────────────────────────────────── */
    .overview-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 8.5pt;
      margin-bottom: 20px;
    }
    .overview-table th {
      text-align: left;
      padding: 6px 10px;
      background: var(--bg3);
      color: var(--text-dim);
      border-bottom: 1px solid var(--border);
      font-weight: 600;
      font-size: 7.5pt;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .overview-table td {
      padding: 5px 10px;
      border-bottom: 1px solid var(--border);
      color: var(--text);
      background: var(--bg2);
    }
    .overview-table tr:nth-child(even) td { background: var(--bg3); }
    .center { text-align: center; }
    .mono   { font-family: 'Courier New', monospace; }
    .small  { font-size: 8pt; }

    /* ── STATUS BADGES ────────────────────────────────────────────────── */
    .badge {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 3px;
      font-size: 7.5pt;
      font-weight: 600;
      letter-spacing: 0.5px;
    }
    .badge-pass   { background: rgba(63,185,80,.15);  color: var(--pass);   border: 1px solid var(--pass);   }
    .badge-fail   { background: rgba(248,81,73,.15);  color: var(--fail);   border: 1px solid var(--fail);   }
    .badge-review { background: rgba(210,153,34,.15); color: var(--gold);   border: 1px solid var(--gold);   }
    .badge-skip   { background: rgba(72,79,88,.15);   color: var(--skip);   border: 1px solid var(--skip);   }
    .badge-error  { background: rgba(219,109,40,.15); color: var(--error);  border: 1px solid var(--error);  }

    .sev-high   { color: var(--fail);   font-weight: 600; }
    .sev-medium { color: var(--gold);   }
    .sev-low    { color: #79c0ff; }

    /* ── CONTROL CARDS ────────────────────────────────────────────────── */
    .ctrl-card {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 6px;
      margin-bottom: 14px;
    }
    .ctrl-card.fail   { border-left: 4px solid var(--fail);   }
    .ctrl-card.review { border-left: 4px solid var(--gold);   }
    .ctrl-card.pass   { border-left: 4px solid var(--pass);   }
    .ctrl-card.skip   { border-left: 4px solid var(--skip);   opacity: 0.65; }
    .ctrl-card.error  { border-left: 4px solid var(--error);  }

    .ctrl-head {
      padding: 9px 14px;
      background: var(--bg3);
      border-bottom: 1px solid var(--border);
      border-radius: 6px 6px 0 0;
      display: flex;
      align-items: baseline;
      gap: 10px;
      flex-wrap: wrap;
    }
    .ctrl-id    { font-weight: 700; font-size: 9.5pt; color: var(--accent); white-space: nowrap; font-family: 'Courier New', monospace; }
    .ctrl-title { flex: 1; font-size: 9.5pt; font-weight: 500; color: var(--text); }
    .ctrl-meta  { font-size: 7.5pt; color: var(--text-dim); width: 100%; margin-top: 2px; }

    .ctrl-body  { padding: 10px 14px; font-size: 8.5pt; }
    .field-row  { margin-bottom: 8px; }
    .field-label {
      font-size: 7.5pt;
      color: var(--text-dim);
      text-transform: uppercase;
      letter-spacing: 1px;
      font-weight: 600;
      margin-bottom: 3px;
    }
    .field-value { padding-left: 2px; }

    .text-pass   { color: var(--pass);   }
    .text-fail   { color: var(--fail);   }
    .text-review { color: var(--gold);   }

    /* ── FINDINGS TABLE ───────────────────────────────────────────────── */
    .findings-wrap { overflow-x: auto; margin-top: 4px; }
    .findings-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 8pt;
    }
    .findings-table th {
      padding: 4px 10px;
      text-align: left;
      background: var(--bg3);
      color: var(--text-dim);
      border-bottom: 1px solid var(--border);
      font-size: 7.5pt;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .findings-table td {
      padding: 3px 10px;
      border-bottom: 1px solid var(--border);
      color: var(--text);
      font-family: 'Courier New', monospace;
      background: var(--bg2);
    }
    .findings-table tr:nth-child(even) td { background: var(--bg3); }
    .truncated {
      color: var(--text-dim);
      font-style: italic;
      text-align: center;
      padding: 6px;
      font-size: 8pt;
    }

    /* ── REMEDIATION ──────────────────────────────────────────────────── */
    .remediation {
      page-break-inside: avoid;
    }
    .remediation pre {
      background: var(--bg3);
      border: 1px solid var(--border);
      border-left: 3px solid var(--gold);
      border-radius: 4px;
      padding: 9px 12px;
      font-size: 8.5pt;
      color: #f0e6c8;
      font-family: 'Courier New', monospace;
      white-space: pre-wrap;
      word-break: break-word;
    }

    /* ── FOOTER ───────────────────────────────────────────────────────── */
    .report-footer {
      margin-top: 36px;
      padding-top: 12px;
      border-top: 1px solid var(--border);
      font-size: 7.5pt;
      color: var(--text-dim);
      text-align: center;
      line-height: 1.8;
    }

    @media print {
      body { background: var(--bg) !important; }
    }
  </style>
</head>
<body>

<!-- ── COVER ──────────────────────────────────────────────────────────────── -->
<div class="cover page-break page">

  <div class="cover-eyebrow">Confidential &nbsp;·&nbsp; Security Audit Report</div>
  <div class="cover-title">RACF Security<br>Audit Report</div>
  <div class="cover-subtitle">CIS IBM z/OS Benchmark &nbsp;·&nbsp; Produced by MFAudit</div>

  <table class="cover-meta">
    <tr><th>System / Sysplex</th><td>{{ system_name }}</td></tr>
    <tr><th>Report Date</th>     <td>{{ report_date }}</td></tr>
    <tr><th>Generated At</th>    <td>{{ generated_at }}</td></tr>
    <tr><th>Controls File</th>   <td>{{ controls_file }}</td></tr>
    <tr><th>Controls Evaluated</th><td>{{ total - skipped }} of {{ total }} &nbsp;({{ skipped }} skipped)</td></tr>
  </table>

  <div class="score-wrap">
    <div class="score-pill {% if score_pct >= 80 %}good{% elif score_pct >= 60 %}warn{% else %}bad{% endif %}">
      {{ score_pct }}%
    </div>
    <div class="score-legend">
      <strong>Compliance Score</strong><br>
      {{ passed }} PASS &nbsp;·&nbsp; {{ failed }} FAIL &nbsp;·&nbsp;
      {{ review }} REVIEW &nbsp;·&nbsp; {{ skipped }} SKIP
      {% if errors %}&nbsp;·&nbsp; {{ errors }} ERROR{% endif %}
    </div>
  </div>

  {% if anonymized %}
  <div class="anon-banner">
    &#128274; ANONYMIZED REPORT — All user IDs, group names, and profile names have been
    replaced with stable labels (USR-NNNN, GRP-NNNN, PRF-NNNN).
    Pass/Fail results and finding counts are accurate and unmodified.
    This report is safe to share externally.
  </div>
  {% endif %}

  <p class="cover-disclaimer">
    This report is produced by automated analysis of RACF runtime data exports.
    REVIEW-status items require human judgement. All findings must be validated by a
    qualified RACF security administrator before remediation.
    &lt;https://github.com/wizardofzos/mfaudit&gt;
  </p>

</div>


<!-- ── EXECUTIVE SUMMARY ──────────────────────────────────────────────────── -->
<div class="page page-break">

  {% if anonymized %}
  <div class="anon-banner">
    &#128274; Anonymized report — identifiers replaced with stable labels.
    All counts, statuses, and SETROPTS values are original and unmodified.
  </div>
  {% endif %}

  <h2>Executive Summary</h2>

  <div class="summary-row">
    <div class="scard pass">   <div class="n">{{ passed }}</div>  <div class="l">PASS</div>   </div>
    <div class="scard fail">   <div class="n">{{ failed }}</div>  <div class="l">FAIL</div>   </div>
    <div class="scard review"> <div class="n">{{ review }}</div>  <div class="l">REVIEW</div> </div>
    <div class="scard skip">   <div class="n">{{ skipped }}</div> <div class="l">SKIP</div>   </div>
    <div class="scard error">  <div class="n">{{ errors }}</div>  <div class="l">ERROR</div>  </div>
  </div>

  <h3>Controls Overview</h3>
  <table class="overview-table">
    <thead>
      <tr>
        <th>Control ID</th>
        <th>Title</th>
        <th>Category</th>
        <th>Severity</th>
        <th>Sources</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      {% for r in results %}
      <tr>
        <td class="mono">{{ r.control_id }}</td>
        <td>{{ r.title }}</td>
        <td class="center small">{{ r.cis_section or r.custom_category or '—' }}</td>
        <td class="center sev-{{ r.severity }}">{{ r.severity or '—' }}</td>
        <td class="center mono small">{{ r.data_sources_needed | join(', ') }}</td>
        <td class="center">
          <span class="badge badge-{{ r.status | lower }}">{{ r.status }}</span>
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

</div>


<!-- ── DETAILED FINDINGS ───────────────────────────────────────────────────── -->
<div class="page">

  <h2>Detailed Findings</h2>

  {% for r in results %}
  <div class="ctrl-card {{ r.status | lower }}">

    <div class="ctrl-head">
      <span class="ctrl-id">{{ r.control_id }}</span>
      <span class="badge badge-{{ r.status | lower }}">{{ r.status }}</span>
      {% if r.severity %}<span class="sev-{{ r.severity }}">{{ r.severity | upper }}</span>{% endif %}
      <span class="ctrl-title">{{ r.title }}</span>
      <span class="ctrl-meta">
        {%- if r.cis_section %}CIS {{ r.cis_section }} &nbsp;·&nbsp; {% endif -%}
        {%- if r.custom_benchmark %}{{ r.custom_benchmark }}
          {%- if r.custom_reference %} &nbsp;·&nbsp; Ref: {{ r.custom_reference }}{% endif %} &nbsp;·&nbsp; {% endif -%}
        Sources: {{ r.data_sources_needed | join(', ') }}
      </span>
    </div>

    <div class="ctrl-body">

      {% if r.requirement %}
      <div class="field-row">
        <div class="field-label">Requirement</div>
        <div class="field-value">{{ r.requirement | trim }}</div>
      </div>
      {% endif %}

      <div class="field-row">
        <div class="field-label">Result</div>
        <div class="field-value {% if r.status == STATUS_PASS %}text-pass{% elif r.status == STATUS_FAIL %}text-fail{% elif r.status == STATUS_REVIEW %}text-review{% endif %}">
          {{ r.detail if r.detail else '—' }}
        </div>
      </div>

      {% if r.findings %}
      <div class="field-row">
        <div class="field-label">Findings <span style="color:var(--text-dim);font-weight:400">({{ r.findings | length }} row(s))</span></div>
        <div class="findings-wrap">
          <table class="findings-table">
            <thead>
              <tr>
                {% for col in r.findings[0].keys() %}<th>{{ col }}</th>{% endfor %}
              </tr>
            </thead>
            <tbody>
              {% for row in r.findings[:50] %}
              <tr>
                {% for val in row.values() %}<td>{{ val }}</td>{% endfor %}
              </tr>
              {% endfor %}
              {% if r.findings | length > 50 %}
              <tr>
                <td colspan="{{ r.findings[0].keys() | list | length }}" class="truncated">
                  … {{ r.findings | length - 50 }} more row(s) — see controls_results.csv for full list.
                </td>
              </tr>
              {% endif %}
            </tbody>
          </table>
        </div>
      </div>
      {% endif %}

      {% if r.remediation and r.status != STATUS_PASS and r.status != STATUS_SKIP %}
      <div class="field-row remediation">
        <div class="field-label">Remediation</div>
        <div class="field-value"><pre>{{ r.remediation | trim }}</pre></div>
      </div>
      {% endif %}

    </div>
  </div>
  {% endfor %}

  <div class="report-footer">
    MFAudit &nbsp;·&nbsp; Generated {{ generated_at }} &nbsp;·&nbsp;
    CIS Benchmark for z/OS &nbsp;·&nbsp; System: {{ system_name }}<br>
    Automated audit output. All findings must be validated by a qualified RACF security
    administrator before remediation.
  </div>

</div>

</body>
</html>
